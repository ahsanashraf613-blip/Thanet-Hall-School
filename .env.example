PORT=3000
NODE_ENV=development

# Admin dashboard login (required for /admin and GET /api/submissions)
ADMIN_PASSWORD=choose-a-strong-password

# Optional: separate secret used to sign admin session cookies.
# Defaults to ADMIN_PASSWORD when unset.
# ADMIN_SESSION_SECRET=

# You can add email service configuration here later.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
